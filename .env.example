# Server Port & Environment
PORT=10000
NODE_ENV=development

# LLM Provider Configuration
# Options: 'gemma_api' (Google AI Studio) | 'ollama' (Local Open Weights) | 'mock'
LLM_PROVIDER=gemma_api
GEMMA_API_KEY=your_google_ai_studio_api_key_here
GEMMA_MODEL=gemma-3-27b-it

# Ollama Configuration (when LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b

# Text-to-Speech Provider Configuration
# Options: 'elevenlabs' | 'browser' (Client Web Speech API)
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
