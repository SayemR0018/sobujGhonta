# Server Port & Environment
PORT=10000
NODE_ENV=development

# LLM Provider Configuration (Open-Weight Outdoor Mindful Planning)
# Options: 'gemma_api' (Google AI Studio) | 'ollama' (Local Open Weights) | 'mock'
LLM_PROVIDER=gemma_api
GEMMA_API_KEY=your_google_ai_studio_api_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it

# Ollama Configuration (when LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b

# Text-to-Speech Provider Configuration (Free provider chain)
# Options: 'auto' | 'gemini' | 'mms' | 'browser' | 'none' (default: auto)
# Fallback sequence in auto mode: gemini -> mms -> sarvam (if key) -> browser
TTS_PROVIDER=auto

# Gemini 3.8 Flash TTS (Uses the SAME Google AI Studio key as Gemma)
# Accepts GEMMA_API_KEY or GEMINI_API_KEY
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore

# Meta MMS-TTS (open-weight facebook/mms-tts-ben / facebook/mms-tts-eng)
# Optional free Hugging Face token for serverless inference router
HF_TOKEN=

# Sarvam AI Bengali TTS (Optional, activated only if key provided)
SARVAM_API_KEY=
