    "test": "node --test server/tests/**/*.test.js"
  },
  "workspaces": [
    "client"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "keywords": [
    "touch-grass",
    "gemma",
    "free-tts",
    "gemini-tts",
    "meta-mms",
    "render",
    "hacktoberfest",
    "bangladesh",
    "dhaka",
    "pwa",
    "air-quality"
  ],
  "author": "Sayem Rahman <rahmansayem163@gmail.com>",
