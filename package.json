{
  "name": "sobuj-ghonta",
  "version": "1.0.0",
  "description": "Sobuj Ghonta (সবুজ ঘণ্টা) — The Green Hour: Ambient, screen-minimizing outdoor companion for safe urban green discovery.",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
