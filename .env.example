# Server Port & Environment
PORT=10000
NODE_ENV=development

# LLM Provider Configuration (Open-Weight Outdoor Mindful Planning)
# Options: 'gemma_api' (Google AI Studio) | 'ollama' (Local Open Weights) | 'mock'
LLM_PROVIDER=gemma_api
GEMMA_API_KEY=your_google_ai_studio_api_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it

# Ollama Configuration (when LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b

# Text-to-Speech Provider Configuration
# Options: 'auto' | 'elevenlabs' | 'gemini' | 'mms' | 'browser' | 'none' (default: auto)
# Fallback sequence in auto mode: elevenlabs (if key set) -> gemini -> mms -> sarvam (if key) -> browser
TTS_PROVIDER=auto

# ElevenLabs Configuration (Optional top tier of TTS_PROVIDER=auto)
# Default voice: "Anika" (jUjRbhZWoMK4aDciW36V). Model: eleven_multilingual_v2
# NOTE FOR FREE ACCOUNTS: ElevenLabs returns HTTP 402 for library voices via the API on Free tier.
# If using a Free ElevenLabs account, specify a default pre-made voice ID:
#   Rachel (calm, clear): 21m00Tcm4TlvDq8ikWAM
#   Domi: AZnzlk1XvdvUeBnXmlld
#   Bella: EXAVITQu4vr4xnSDxMaL
#   Antoni: ErXwobaYiN019PkySvjV
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=jUjRbhZWoMK4aDciW36V
ELEVENLABS_VOICE_ID_BN=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_MONTHLY_CHAR_CAP=8000

# Gemini 3.8 Flash TTS (Uses the SAME Google AI Studio key as Gemma)
# Accepts GEMMA_API_KEY or GEMINI_API_KEY
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore

# Meta MMS-TTS (open-weight facebook/mms-tts-ben / facebook/mms-tts-eng)
# Optional free Hugging Face token for serverless inference router
HF_TOKEN=

# Sarvam AI Bengali TTS (Optional, activated only if key provided)
SARVAM_API_KEY=

# ==============================================================================
# TabPFN (Prior Labs Tabular Foundation Model) & Python ML Sidecar
# Documentation: https://docs.priorlabs.ai | https://cloud.priorlabs.ai
# ==============================================================================
# Execution mode for TabPFN tabular forecasting and anomaly detection:
#   'auto'   : Auto-detects available mode (client token -> local PyTorch -> deterministic fallback)
#   'client' : Prior Labs Cloud Client API (requires TABPFN_TOKEN)
#   'local'  : Local PyTorch TabPFN Foundation Model running in Python FastAPI sidecar
#   'off'    : Disables ML sidecar; uses deterministic baseline (labeled "baseline (not TabPFN)")
TABPFN_MODE=auto

# Prior Labs Client API Token (from https://cloud.priorlabs.ai)
# Also accepted: TABPFN_API_KEY or PRIOR_LABS_API_KEY
TABPFN_TOKEN=your_prior_labs_tabpfn_token_here

# Python FastAPI ML Sidecar URL & Binding (when running ml/app.py)
ML_SIDECAR_URL=http://127.0.0.1:8000
ML_HOST=127.0.0.1
ML_PORT=8000

# Anomaly Detection Thresholds (Statistical residual bounds against local distribution)
ANOMALY_Z_THRESHOLD=2.0
ANOMALY_QUANTILE_THRESHOLD=0.95

# ==============================================================================
# Live Web Search (Unified Adapter for SerpApi & Serper.dev)
# Primary: SerpApi (Google Search Engine) | Alt: Serper.dev | Zero-Key: none
# ==============================================================================
# Provider selection:
#   'serpapi' : Google Search via SerpApi (Documentation: https://serpapi.com/search-api)
#   'serper'  : Google Search via Serper.dev (Documentation: https://serper.dev)
#   'none'    : Zero-key offline mode with dated city snapshots (0 API keys, 0 network calls)
#   (Leave empty for auto-detection: checks SERPAPI_API_KEY -> SERPER_API_KEY -> none)
SEARCH_PROVIDER=serpapi

# SerpApi API Key (from https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=your_serpapi_api_key_here

# Serper.dev API Key (Alternative provider from https://serper.dev/api-key)
SERPER_API_KEY=your_serper_api_key_here
